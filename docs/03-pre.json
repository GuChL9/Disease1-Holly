          {
            "type": "text",
            "content": "在慢性肾脏病-矿物质与骨异常(CKD-MBD)的发生过程中, 出现最早, 最敏感的生化指标变化是:"
          }
        ],
        "options": [
          {
            "type": "text",
            "content": "血钙降低",
            "correct": false,
            "option_id": "3339cb34-551f-4f28-afbc-5501f5a66332"
          },
          {
            "type": "text",
            "content": "血磷升高",
            "correct": false,
            "option_id": "1c0dbd43-6456-4dc6-bff2-369a79853f71"
          },
          {
            "type": "text",
            "content": "成纤维细胞生长因子23(FGF23)升高",
            "correct": true,
            "option_id": "eaab90d0-d13b-4470-980c-610904cdcef3"
          },
          {
            "type": "text",
            "content": "甲状旁腺激素(PTH)降低",
            "correct": false,
            "option_id": "7e79d848-9749-417e-a39d-7f6d12c33740"
          },
          {
            "type": "text",
            "content": "碱性磷酸酶降低",
            "correct": false,
            "option_id": "4b76dc58-de63-4958-8299-d9bfb04ad6d7"
          }
        ],

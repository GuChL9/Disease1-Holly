          },
          {
            "type": "text",
            "content": "交感神经促进肾素释放, 血管紧张素Ⅱ舒张小动脉",
            "correct": false,
            "option_id": "98e32681-20d6-44ea-ab83-07af0d27f8c1"
          },
          {
            "type": "text",
            "content": "交感神经收缩小动脉, 醛固酮促进肾脏排钠",
            "correct": false,
            "option_id": "dc6c3fa7-e4e6-46d1-96cd-9e608704da2a"
          },
          {
            "type": "text",
            "content": "交感神经抑制肾素释放, 醛固酮增加血容量",
            "correct": false,
            "option_id": "9b2c261d-8594-427b-a094-3f10571a63c1"
          }
        ],

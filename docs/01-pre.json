            "option_id": "c5d39427-d3c1-4f93-bde4-0b2b462a33d5"
          },
          {
            "type": "text",
            "content": "长期激活仅影响血压，不影响心衰进展",
            "correct": false,
            "option_id": "5fbb6c91-641b-4d22-bf81-5b706056dfaa"
          }
        ],
